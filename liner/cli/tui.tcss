/* The look of Linerator, the one of Pushterator: a dark background, rounded
   cards, violet for what matters. Small terminals (under 30 lines) get the
   "-compact" class: the logo on one line, no tagline. */

Screen {
	background: #0f1117;
	color: #d1d5db;
}

/* --- home -------------------------------------------------------------- */

HomeScreen {
	align: center middle;
}

.root {
	width: 64;
	height: auto;
}

.logo {
	width: 100%;
	height: 6;
	content-align: center middle;
}

.tagline {
	width: 100%;
	content-align: center middle;
	color: #6b7280;
	margin-bottom: 1;
}

.-compact .logo { height: 1; }
.-compact .tagline { display: none; }
.-compact .hints { margin-top: 0; }

.card {
	height: auto;
	border: round #2a2f3a;
	border-title-color: #a5b4fc;
	border-title-style: bold;
	padding: 1 1 0 1;
	background: #151821;
}

.field-label {
	color: #9ca3af;
	padding: 0 1;
}

HomeScreen Input {
	margin-bottom: 1;
	background: #0f1117;
	border: tall #2a2f3a;
}

HomeScreen Input:focus {
	border: tall #a5b4fc;
}

#folder-status {
	padding: 0 1;
	height: auto;
}

#folders, #folders:focus {
	height: auto;
	max-height: 12;
	margin-bottom: 1;
	background: #151821;
	border: none;
	padding: 0;
}

OptionList > .option-list--option-highlighted {
	background: #2a2f3a;
	color: #e0e7ff;
}

.hints {
	width: 100%;
	content-align: center middle;
	margin-top: 1;
	color: #4b5563;
}

.disclaimer {
	width: 100%;
	content-align: center middle;
	text-align: center;
	margin-top: 1;
	color: #4b5563;
	text-style: italic;
}

/* --- run --------------------------------------------------------------- */

RunScreen {
	layout: vertical;
}

#header {
	height: 3;
	padding: 0 2;
	border: round #2a2f3a;
	border-title-color: #a5b4fc;
	border-title-style: bold;
	background: #151821;
}

#body {
	height: 1fr;
	layout: horizontal;
}

#log {
	width: 1fr;
	height: 100%;
	border: round #2a2f3a;
	border-title-color: #a5b4fc;
	background: #0f1117;
	padding: 0 1;
	scrollbar-size: 1 1;
}

#sizes {
	width: 46;
	height: 100%;
	border: round #2a2f3a;
	border-title-color: #a5b4fc;
	border-title-style: bold;
	background: #151821;
	padding: 1 2;
}

#activity {
	height: 1;
	padding: 0 2;
	color: #fbbf24;
	display: none;
}

#activity.-busy {
	display: block;
}

#run-hints {
	height: 1;
	padding: 0 2;
	color: #4b5563;
}

/* --- visualizer -------------------------------------------------------- */

VisualizerScreen {
	layout: vertical;
}

#viz-header {
	height: 3;
	padding: 0 2;
	border: round #2a2f3a;
	border-title-color: #a5b4fc;
	border-title-style: bold;
	background: #151821;
}

#viz-body {
	height: 1fr;
}

#viz-left {
	width: 1fr;
	height: 100%;
}

#viz-file {
	height: 1fr;
	border: round #2a2f3a;
	border-title-color: #a5b4fc;
	border-title-style: bold;
	background: #0f1117;
	padding: 1 1;
}

#viz-steps {
	height: 12;
	border: round #2a2f3a;
	border-title-color: #a5b4fc;
	border-title-style: bold;
	background: #0f1117;
	padding: 1 1;
}

#viz-now {
	width: 46;
	height: 100%;
	border: round #2a2f3a;
	border-title-color: #a5b4fc;
	border-title-style: bold;
	background: #151821;
	padding: 1 2;
}

#viz-hints {
	height: 1;
	padding: 0 2;
	color: #4b5563;
}
